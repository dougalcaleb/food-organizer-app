{
	"name": "food-organizer-app",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "run-s typecheck build-only",
		"build-only": "vite build",
		"preview": "vite preview",
		"typecheck": "vue-tsc --build",
		"lint": "eslint . --fix",
		"lint:check": "eslint .",
		"format": "prettier --write .",
