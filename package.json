		"npm-run-all2": "^8.0.4",
		"prettier": "^3.9.6",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.67.0",
		"vite": "^8.2.2",
		"vite-plugin-pwa": "^1.3.0",
		"vitest": "^4.1.11",
		"vue-tsc": "^3.3.11"
